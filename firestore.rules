rules_version = '2';

// =====================================================================
// REGLAS DE SEGURIDAD DE RUTA
// Firebase Console > Firestore Database > Reglas
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // AYUDANTES GENERALES
    // -----------------------------------------------------------------
    function esDeConaltura() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z]+@conaltura[.]com$');
    }

    function rol() {
      return request.auth.token.email.split('@')[0];
    }

    function tieneRol(roles) {
      return esDeConaltura() && rol() in roles;
    }

    function agrupaciones() {
      return {
        'AGR-A-AM1': ['Proyecto A · Apartamento modelo T1', 'PRY-A'],
        'AGR-B-SV': ['Proyecto B · Sala de ventas', 'PRY-B'],
        'AGR-B-AM1': ['Proyecto B · Apartamento modelo T1', 'PRY-B'],
        'AGR-B-AM2': ['Proyecto B · Apartamento modelo T2', 'PRY-B'],
        'AGR-C-SV': ['Proyecto C · Sala de ventas', 'PRY-C'],
        'AGR-C-AM1': ['Proyecto C · Apartamento modelo T1', 'PRY-C'],
        'AGR-D-SV': ['Proyecto D · Sala de ventas', 'PRY-D'],
        'AGR-D-AM1': ['Proyecto D · Apartamento modelo T1', 'PRY-D'],
        'AGR-BOD': ['Bodega central', 'BOD']
      };
    }

    function ubicacionValida(u) {
      return u in [
        'Proyecto A · Apartamento modelo T1',
        'Proyecto B · Sala de ventas',
        'Proyecto B · Apartamento modelo T1',
        'Proyecto B · Apartamento modelo T2',
        'Proyecto C · Sala de ventas',
        'Proyecto C · Apartamento modelo T1',
        'Proyecto D · Sala de ventas',
        'Proyecto D · Apartamento modelo T1',
        'Bodega central'
      ];
    }

    function categoriaValida(categoria) {
      return categoria in [
        'Mobiliario',
        'Decoración',
        'Textiles',
        'Iluminación',
        'Menaje',
        'Plantas y materas',
        'Electrodomésticos',
        'Tecnología',
        'Material comercial',
        'Utilería'
      ];
    }

    function estadoFisicoValido(estado) {
      return estado in ['Bueno', 'Regular', 'Dañado', 'N/A'];
    }

    function estadoGestionValido(estado) {
      return estado in [
        'Asignado',
        'En reparación',
        'En tránsito',
        'En bodega',
        'En lista de saldos',
        'Pendiente de llegada',
        'De baja'
      ];
    }

    // -----------------------------------------------------------------
    // VALIDACIONES DEL INVENTARIO
    // -----------------------------------------------------------------
    function datosValidos(codigo) {
      let d = request.resource.data;
      let agr = agrupaciones();

      return d.codigo == codigo
        && codigo.matches('^EL-[0-9]{5}$')
        && d.nombre is string
        && d.nombre.size() > 0
        && d.nombre.size() <= 100
        && categoriaValida(d.categoria)
        && d.agrupacion in agr.keys()
        && agr[d.agrupacion][0] == d.ubicacion
        && agr[d.agrupacion][1] == d.proyecto
        && d.espacio is string
        && d.espacio.size() <= 60
        && d.cantidad is int
        && d.cantidad >= 1
        && d.cantidad <= 9999
        && estadoFisicoValido(d.estado)
        && estadoGestionValido(d.estadoGestion)
        && d.valorUnitario is int
        && d.valorUnitario >= 0
        && d.fechaCompra is string
        && d.fechaCompra.size() <= 10
        && d.proveedor is string
        && d.proveedor.size() <= 100
        && d.reparaciones is int
        && d.reparaciones >= 0
        && d.responsable in [
          'Vendedor',
          'Bodeguista',
          'Coordinador de sala',
          'Compras',
          'Administrador'
        ]
        && (!('foto' in d) || (d.foto is string && d.foto.size() < 300000))
        && d.actualizadoPor == rol()
        && d.actualizadoEn == request.time;
    }

    function aprobacionAlRegistrar() {
      let d = request.resource.data;

      return (
          tieneRol(['administrador'])
          && d.aprobacion == 'Aprobado'
          && d.aprobadoPor == 'administrador'
          && d.motivoRechazo == ''
        ) || (
          tieneRol(['vendedor', 'bodeguista', 'compras'])
          && d.aprobacion == 'Pendiente'
          && d.aprobadoPor == ''
          && d.motivoRechazo == ''
        );
    }

    function puedeRegistrarAhi() {
      return tieneRol(['administrador', 'bodeguista'])
        || (tieneRol(['compras']) && resource == null)
        || (
          tieneRol(['vendedor'])
          && request.resource.data.ubicacion != 'Bodega central'
        );
    }

    function decisionValida() {
      let d = request.resource.data;

      return tieneRol(['coordinador', 'administrador'])
        && d.diff(resource.data).affectedKeys().hasOnly([
          'aprobacion',
          'aprobadoPor',
          'aprobadoEn',
          'motivoRechazo'
        ])
        && d.aprobacion in ['Aprobado', 'Rechazado']
        && d.aprobadoPor == rol()
        && d.aprobadoEn == request.time
        && d.motivoRechazo is string
        && d.motivoRechazo.size() <= 200
        && (d.aprobacion == 'Aprobado' || d.motivoRechazo.size() > 0);
    }

    function movimientoPorTraslado(codigo) {
      let d = request.resource.data;
      let agr = agrupaciones();
      let traslado = getAfter(
        /databases/$(database)/documents/traslados/$(d.ultimoTraslado)
      ).data;

      return tieneRol(['bodeguista', 'administrador'])
        && d.diff(resource.data).affectedKeys().hasOnly([
          'ubicacion',
          'agrupacion',
          'proyecto',
          'estadoGestion',
          'ultimoTraslado'
        ])
        && d.agrupacion in agr.keys()
        && agr[d.agrupacion][0] == d.ubicacion
        && agr[d.agrupacion][1] == d.proyecto
        && d.estadoGestion in ['Asignado', 'En bodega']
        && d.ultimoTraslado is string
        && traslado.estado == 'Recibido'
        && traslado.codigoElemento == codigo
        && traslado.destino == d.ubicacion;
    }

    // Permite al rol unificado Compras/Administración y Finanzas editar
    // únicamente datos básicos o la disposición del activo.
    function administracionActivoValida(codigo) {
      let d = request.resource.data;
      let cambios = d.diff(resource.data).affectedKeys();

      return tieneRol(['compras', 'administrador'])
        && d.codigo == codigo
        && datosValidos(codigo)
        && cambios.hasOnly([
          'nombre',
          'estado',
          'responsable',
          'observaciones',
          'estadoGestion',
          'fechaDisposicion',
          'motivoDisposicion',
          'observacionesDisposicion',
          'actualizadoPor',
          'actualizadoEn'
        ])
        && (!cambios.hasAny(['nombre'])
            || (d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 100))
        && (!cambios.hasAny(['estado']) || estadoFisicoValido(d.estado))
        && (!cambios.hasAny(['estadoGestion'])
            || d.estadoGestion in ['En lista de saldos', 'De baja'])
        && (!cambios.hasAny(['fechaDisposicion'])
            || (d.fechaDisposicion is string && d.fechaDisposicion.size() == 10))
        && (!cambios.hasAny(['motivoDisposicion'])
            || (d.motivoDisposicion is string
                && d.motivoDisposicion.size() > 0
                && d.motivoDisposicion.size() <= 100))
        && (!cambios.hasAny(['observacionesDisposicion'])
            || (d.observacionesDisposicion is string
                && d.observacionesDisposicion.size() <= 300));
    }

    // -----------------------------------------------------------------
    // COLECCIÓN INVENTARIO
    // -----------------------------------------------------------------
    match /inventario/{codigo} {
      allow read: if tieneRol([
        'vendedor',
        'bodeguista',
        'administrador',
        'compras',
        'coordinador'
      ]);

      allow create: if datosValidos(codigo)
        && aprobacionAlRegistrar()
        && puedeRegistrarAhi();

      allow update: if (
          datosValidos(codigo)
          && aprobacionAlRegistrar()
          && puedeRegistrarAhi()
          && !(tieneRol(['vendedor'])
               && resource.data.ubicacion == 'Bodega central')
        )
        || decisionValida()
        || movimientoPorTraslado(codigo)
        || administracionActivoValida(codigo);

      allow delete: if tieneRol(['administrador']);
    }

    // -----------------------------------------------------------------
    // COLECCIÓN TRASLADOS
    // -----------------------------------------------------------------
    match /traslados/{id} {
      allow read: if tieneRol([
        'vendedor',
        'bodeguista',
        'administrador',
        'compras',
        'coordinador'
      ]);

      allow create: if tieneRol(['vendedor', 'administrador'])
        && request.resource.data.keys().hasOnly([
          'codigoElemento',
          'nombreElemento',
          'origen',
          'destino',
          'motivo',
          'estado',
          'solicitadoPor',
          'solicitadoEn'
        ])
        && request.resource.data.estado == 'Solicitado'
        && request.resource.data.solicitadoPor == rol()
        && request.resource.data.solicitadoEn == request.time
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0
        && request.resource.data.motivo.size() <= 200
        && ubicacionValida(request.resource.data.destino)
        && request.resource.data.destino != request.resource.data.origen
        && exists(
          /databases/$(database)/documents/inventario/$(request.resource.data.codigoElemento)
        )
        && get(
          /databases/$(database)/documents/inventario/$(request.resource.data.codigoElemento)
        ).data.ubicacion == request.resource.data.origen
        && get(
          /databases/$(database)/documents/inventario/$(request.resource.data.codigoElemento)
        ).data.aprobacion == 'Aprobado';

      allow update: if (
          resource.data.estado == 'Solicitado'
          && tieneRol(['coordinador'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'aprobadoPor',
            'aprobadoEn',
            'motivoRechazo'
          ])
          && request.resource.data.estado in ['Aprobado', 'Rechazado']
          && request.resource.data.aprobadoPor == rol()
          && request.resource.data.aprobadoEn == request.time
          && request.resource.data.motivoRechazo is string
          && request.resource.data.motivoRechazo.size() <= 200
          && (
            request.resource.data.estado == 'Aprobado'
            || request.resource.data.motivoRechazo.size() > 0
          )
        ) || (
          resource.data.estado == 'Aprobado'
          && tieneRol(['bodeguista', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'enviadoPor',
            'enviadoEn'
          ])
          && request.resource.data.estado == 'En tránsito'
          && request.resource.data.enviadoPor == rol()
          && request.resource.data.enviadoEn == request.time
        ) || (
          resource.data.estado == 'En tránsito'
          && tieneRol(['bodeguista', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'recibidoPor',
            'recibidoEn'
          ])
          && request.resource.data.estado == 'Recibido'
          && request.resource.data.recibidoPor == rol()
          && request.resource.data.recibidoEn == request.time
          && getAfter(
            /databases/$(database)/documents/inventario/$(resource.data.codigoElemento)
          ).data.ubicacion == resource.data.destino
        );

      allow delete: if tieneRol(['administrador']);
    }

    // -----------------------------------------------------------------
    // COLECCIÓN COMPRAS
    // -----------------------------------------------------------------
    match /compras/{id} {
      allow read: if tieneRol([
        'vendedor',
        'bodeguista',
        'administrador',
        'compras',
        'coordinador'
      ]);

      allow create: if tieneRol(['vendedor', 'compras', 'administrador'])
        && request.resource.data.keys().hasOnly([
          'nombre',
          'categoria',
          'cantidad',
          'destino',
          'motivo',
          'elementoRelacionado',
          'estado',
          'solicitadoPor',
          'solicitadoEn'
        ])
        && request.resource.data.estado == 'Solicitada'
        && request.resource.data.solicitadoPor == rol()
        && request.resource.data.solicitadoEn == request.time
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && categoriaValida(request.resource.data.categoria)
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 1
        && request.resource.data.cantidad <= 50
        && ubicacionValida(request.resource.data.destino)
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0
        && request.resource.data.motivo.size() <= 300;

      allow update: if (
          resource.data.estado == 'Solicitada'
          && tieneRol(['compras', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'revisadoPor',
            'revisadoEn',
            'motivoRechazo',
            'reutilizaCodigo'
          ])
          && request.resource.data.estado in [
            'Aprobada',
            'Rechazada',
            'Reutilizada'
          ]
          && request.resource.data.revisadoPor == rol()
          && request.resource.data.revisadoEn == request.time
          && (
            request.resource.data.estado != 'Rechazada'
            || request.resource.data.motivoRechazo.size() > 0
          )
          && (
            request.resource.data.estado != 'Reutilizada'
            || exists(
              /databases/$(database)/documents/inventario/$(request.resource.data.reutilizaCodigo)
            )
          )
        ) || (
          resource.data.estado == 'Aprobada'
          && tieneRol(['compras', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'compradoPor',
            'compradoEn',
            'valorUnitario',
            'codigosCreados'
          ])
          && request.resource.data.estado == 'Comprada'
          && request.resource.data.compradoPor == rol()
          && request.resource.data.compradoEn == request.time
          && request.resource.data.valorUnitario is int
          && request.resource.data.valorUnitario >= 0
          && request.resource.data.codigosCreados is list
          && request.resource.data.codigosCreados.size() == resource.data.cantidad
        );

      allow delete: if tieneRol(['administrador']);
    }

    // -----------------------------------------------------------------
    // COLECCIÓN MOVIMIENTOS DE ACTIVOS
    // -----------------------------------------------------------------
    match /movimientos_activos/{id} {
      // El historial forma parte de la trazabilidad general del activo.
      allow read: if tieneRol([
        'vendedor',
        'bodeguista',
        'administrador',
        'compras',
        'coordinador'
      ]);

      // Solo el área unificada y el Administrador crean movimientos.
      allow create: if tieneRol(['compras', 'administrador'])
        && request.resource.data.keys().hasOnly([
          'codigoActivo',
          'nombreActivo',
          'tipo',
          'estadoAnterior',
          'estadoNuevo',
          'motivo',
          'observaciones',
          'creadoPor',
          'creadoEn'
        ])
        && request.resource.data.codigoActivo is string
        && request.resource.data.codigoActivo.matches('^EL-[0-9]{5}$')
        && request.resource.data.nombreActivo is string
        && request.resource.data.nombreActivo.size() <= 100
        && request.resource.data.tipo in [
          'ADQUISICIÓN',
          'ACTUALIZACIÓN',
          'SALDO',
          'BAJA'
        ]
        && request.resource.data.estadoAnterior is string
        && request.resource.data.estadoAnterior.size() <= 40
        && request.resource.data.estadoNuevo is string
        && request.resource.data.estadoNuevo.size() <= 40
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() <= 150
        && request.resource.data.observaciones is string
        && request.resource.data.observaciones.size() <= 300
        && request.resource.data.creadoPor == rol()
        && request.resource.data.creadoEn == request.time
        && exists(
          /databases/$(database)/documents/inventario/$(request.resource.data.codigoActivo)
        );

      // Los movimientos son inmutables: no se editan.
      allow update: if false;

      // Solo el Administrador puede limpiar la colección durante una demo.
      allow delete: if tieneRol(['administrador']);
    }
  }
}
