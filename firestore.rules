rules_version = '2';

// =====================================================================
// REGLAS DE SEGURIDAD DEL RUTA
// Se copian y pegan en: Firebase > Firestore Database > pestaña "Reglas"
//
// Estas reglas se revisan en los servidores de Google, NO en la página.
// Aunque alguien modifique el JavaScript, no puede saltárselas.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudantes ----------

    // ¿Inició sesión con un correo de Conaltura? (ej: vendedor@conaltura.com)
    function esDeConaltura() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z]+@conaltura[.]com$');
    }

    // El rol es lo que va antes de la @
    function rol() {
      return request.auth.token.email.split('@')[0];
    }

    function tieneRol(roles) {
      return esDeConaltura() && rol() in roles;
    }

    // Revisa que los datos del elemento estén completos y sean válidos
    function datosValidos(codigo) {
      let d = request.resource.data;
      return d.codigo == codigo
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 100
        && d.categoria in ['Mobiliario', 'Decoración', 'Electrodomésticos', 'Tecnología', 'Material publicitario', 'Otro']
        && d.ubicacion in ['Bodega central', 'Sala de ventas - Proyecto 1', 'Apartamento modelo - Proyecto 1', 'Sala de ventas - Proyecto 2', 'Apartamento modelo - Proyecto 2']
        && d.estado in ['Bueno', 'Regular', 'Malo']
        && d.responsable in ['Coordinador de sala', 'Bodeguista', 'Administrador', 'Compras', 'Vendedor']
        && (!('foto' in d) || (d.foto is string && d.foto.size() < 300000))
        && (!('valorCompra' in d) || (d.valorCompra is int && d.valorCompra >= 0))
        && d.actualizadoPor == rol();
    }

    // APROBACIÓN al registrar:
    // - El Administrador registra ya aprobado.
    // - El Vendedor, el Bodeguista y Compras registran como Pendiente
    //   (quien registra no se aprueba a sí mismo).
    function aprobacionAlRegistrar() {
      let d = request.resource.data;
      return (tieneRol(['administrador'])
              && d.aprobacion == 'Aprobado' && d.aprobadoPor == 'administrador' && d.motivoRechazo == '')
          || (tieneRol(['vendedor', 'bodeguista', 'compras'])
              && d.aprobacion == 'Pendiente' && d.aprobadoPor == '' && d.motivoRechazo == '');
    }

    // ¿Quién puede registrar en esa ubicación?
    // Administrador y Bodeguista: en cualquiera.
    // Compras: solo crea (cuando registra una compra), en cualquiera.
    // Vendedor: solo en salas y apartamentos modelo (no en la bodega).
    function puedeRegistrarAhi() {
      return tieneRol(['administrador', 'bodeguista'])
        || (tieneRol(['compras']) && resource == null)
        || (tieneRol(['vendedor']) && request.resource.data.ubicacion != 'Bodega central');
    }

    // DECISIÓN de aprobación (Coordinador o Administrador):
    // solo puede cambiar los datos de aprobación, nada más del elemento.
    function decisionValida() {
      let d = request.resource.data;
      return tieneRol(['coordinador', 'administrador'])
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['aprobacion', 'aprobadoPor', 'aprobadoEn', 'motivoRechazo'])
        && d.aprobacion in ['Aprobado', 'Rechazado']
        && d.aprobadoPor == rol()
        && d.aprobadoEn == request.time
        && d.motivoRechazo is string && d.motivoRechazo.size() <= 200
        && (d.aprobacion == 'Aprobado' || d.motivoRechazo.size() > 0);
    }

    // MOVIMIENTO por traslado (Bodeguista o Administrador):
    // solo puede cambiar la ubicación, y solo hacia el destino de un
    // traslado que en ese mismo momento queda "Recibido".
    function movimientoPorTraslado(codigo) {
      let d = request.resource.data;
      let traslado = getAfter(/databases/$(database)/documents/traslados/$(d.ultimoTraslado)).data;
      return tieneRol(['bodeguista', 'administrador'])
        && d.diff(resource.data).affectedKeys().hasOnly(['ubicacion', 'ultimoTraslado'])
        && d.ultimoTraslado is string
        && traslado.estado == 'Recibido'
        && traslado.codigoElemento == codigo
        && traslado.destino == d.ubicacion;
    }

    function ubicacionValida(u) {
      return u in ['Bodega central', 'Sala de ventas - Proyecto 1', 'Apartamento modelo - Proyecto 1', 'Sala de ventas - Proyecto 2', 'Apartamento modelo - Proyecto 2'];
    }

    // ---------- Colección "inventario" ----------
    match /inventario/{codigo} {

      // Todos los roles pueden VER el inventario
      allow read: if tieneRol(['vendedor', 'bodeguista', 'administrador', 'compras', 'coordinador']);

      // CREAR un elemento
      allow create: if datosValidos(codigo) && aprobacionAlRegistrar() && puedeRegistrarAhi();

      // MODIFICAR: o es un nuevo registro (vuelve a quedar pendiente),
      //            o es la decisión del Coordinador / Administrador.
      // El Vendedor tampoco puede tocar algo que hoy esté en la bodega.
      allow update: if (datosValidos(codigo) && aprobacionAlRegistrar() && puedeRegistrarAhi()
                        && !(tieneRol(['vendedor']) && resource.data.ubicacion == 'Bodega central'))
                    || decisionValida()
                    || movimientoPorTraslado(codigo);

      // BORRAR: solo el Administrador
      allow delete: if tieneRol(['administrador']);
    }

    // ---------- Colección "traslados" ----------
    // Estados: Solicitado -> Aprobado -> En tránsito -> Recibido
    //                     -> Rechazado
    match /traslados/{id} {

      // Todos los roles pueden ver los traslados (historial)
      allow read: if tieneRol(['vendedor', 'bodeguista', 'administrador', 'compras', 'coordinador']);

      // SOLICITAR (Vendedor o Administrador): el elemento debe existir,
      // estar aprobado, y el origen debe ser donde está hoy.
      allow create: if tieneRol(['vendedor', 'administrador'])
        && request.resource.data.keys().hasOnly(['codigoElemento', 'nombreElemento', 'origen', 'destino',
                                                 'motivo', 'estado', 'solicitadoPor', 'solicitadoEn'])
        && request.resource.data.estado == 'Solicitado'
        && request.resource.data.solicitadoPor == rol()
        && request.resource.data.solicitadoEn == request.time
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0 && request.resource.data.motivo.size() <= 200
        && ubicacionValida(request.resource.data.destino)
        && request.resource.data.destino != request.resource.data.origen
        && exists(/databases/$(database)/documents/inventario/$(request.resource.data.codigoElemento))
        && get(/databases/$(database)/documents/inventario/$(request.resource.data.codigoElemento)).data.ubicacion
             == request.resource.data.origen
        && get(/databases/$(database)/documents/inventario/$(request.resource.data.codigoElemento)).data.aprobacion
             == 'Aprobado';

      // AVANZAR el traslado: cada paso lo hace su rol y solo cambia sus datos
      allow update: if
        // SOLO el Coordinador aprueba o rechaza una solicitud
        (resource.data.estado == 'Solicitado'
          && tieneRol(['coordinador'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'aprobadoPor', 'aprobadoEn', 'motivoRechazo'])
          && request.resource.data.estado in ['Aprobado', 'Rechazado']
          && request.resource.data.aprobadoPor == rol()
          && request.resource.data.aprobadoEn == request.time
          && request.resource.data.motivoRechazo is string
          && request.resource.data.motivoRechazo.size() <= 200
          && (request.resource.data.estado == 'Aprobado' || request.resource.data.motivoRechazo.size() > 0))
        // Bodeguista (o Admin) lo envía
        || (resource.data.estado == 'Aprobado'
          && tieneRol(['bodeguista', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'enviadoPor', 'enviadoEn'])
          && request.resource.data.estado == 'En tránsito'
          && request.resource.data.enviadoPor == rol()
          && request.resource.data.enviadoEn == request.time)
        // Bodeguista (o Admin) lo recibe, y al mismo tiempo el elemento
        // queda en el destino
        || (resource.data.estado == 'En tránsito'
          && tieneRol(['bodeguista', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'recibidoPor', 'recibidoEn'])
          && request.resource.data.estado == 'Recibido'
          && request.resource.data.recibidoPor == rol()
          && request.resource.data.recibidoEn == request.time
          && getAfter(/databases/$(database)/documents/inventario/$(resource.data.codigoElemento)).data.ubicacion
               == resource.data.destino);

      // BORRAR: solo el Administrador (para reiniciar las demos)
      allow delete: if tieneRol(['administrador']);
    }

    // ---------- Colección "compras" ----------
    // Estados: Solicitada -> Aprobada -> Comprada
    //                     -> Reutilizada (se usa algo que ya existe)
    //                     -> Rechazada
    match /compras/{id} {

      allow read: if tieneRol(['vendedor', 'bodeguista', 'administrador', 'compras', 'coordinador']);

      // SOLICITAR una compra (Vendedor, Compras o Administrador)
      allow create: if tieneRol(['vendedor', 'compras', 'administrador'])
        && request.resource.data.keys().hasOnly(['nombre', 'categoria', 'cantidad', 'destino', 'motivo',
                                                 'elementoRelacionado', 'estado', 'solicitadoPor', 'solicitadoEn'])
        && request.resource.data.estado == 'Solicitada'
        && request.resource.data.solicitadoPor == rol()
        && request.resource.data.solicitadoEn == request.time
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100
        && request.resource.data.categoria in ['Mobiliario', 'Decoración', 'Electrodomésticos', 'Tecnología', 'Material publicitario', 'Otro']
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 1 && request.resource.data.cantidad <= 50
        && ubicacionValida(request.resource.data.destino)
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0 && request.resource.data.motivo.size() <= 300;

      allow update: if
        // Compras (o Admin) revisa: aprueba, rechaza o manda a reutilizar
        (resource.data.estado == 'Solicitada'
          && tieneRol(['compras', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'revisadoPor', 'revisadoEn', 'motivoRechazo', 'reutilizaCodigo'])
          && request.resource.data.estado in ['Aprobada', 'Rechazada', 'Reutilizada']
          && request.resource.data.revisadoPor == rol()
          && request.resource.data.revisadoEn == request.time
          && (request.resource.data.estado != 'Rechazada' || request.resource.data.motivoRechazo.size() > 0)
          && (request.resource.data.estado != 'Reutilizada'
              || exists(/databases/$(database)/documents/inventario/$(request.resource.data.reutilizaCodigo))))
        // Compras (o Admin) registra lo que compró
        || (resource.data.estado == 'Aprobada'
          && tieneRol(['compras', 'administrador'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'compradoPor', 'compradoEn', 'valorUnitario', 'codigosCreados'])
          && request.resource.data.estado == 'Comprada'
          && request.resource.data.compradoPor == rol()
          && request.resource.data.compradoEn == request.time
          && request.resource.data.valorUnitario is int && request.resource.data.valorUnitario >= 0
          && request.resource.data.codigosCreados is list
          && request.resource.data.codigosCreados.size() == resource.data.cantidad);

      allow delete: if tieneRol(['administrador']);
    }
  }
}
